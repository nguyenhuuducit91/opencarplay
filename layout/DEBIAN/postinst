#!/bin/sh
# OpenCarPlay — sau khi cài.
#
# Chỉ khởi động lại process CarPlay dashboard: nó nạp lại tweak ngay mà không ảnh
# hưởng gì tới màn hình iPhone. Phần trong SpringBoard cần respring, và việc đó để
# trình quản lý gói tự đề xuất — tự ý respring trong postinst là hành vi thô bạo,
# nhất là khi người dùng đang cài nhiều gói một lượt.

set -e

PREFS_DIR="/var/mobile/Library/Preferences"
JBROOT=""
[ -d /var/jb/usr/lib ] && JBROOT="/var/jb"

# CarPlay.app chỉ chạy khi đang kết nối; không chạy thì lệnh này vô hại.
killall -9 CarPlay 2>/dev/null || true

# Cấu hình của bản <= 0.30 nằm sai chỗ (/var/jb/var/mobile/...) nên tweak không bao
# giờ đọc được thứ người dùng bật trong Settings. Chuyển sang vị trí đúng.
LEGACY="/var/jb$PREFS_DIR/com.opencarplay.plist"
if [ -f "$LEGACY" ] && [ ! -f "$PREFS_DIR/com.opencarplay.plist" ]; then
    mv "$LEGACY" "$PREFS_DIR/com.opencarplay.plist"
    chown mobile:mobile "$PREFS_DIR/com.opencarplay.plist" 2>/dev/null || true
    echo "OpenCarPlay: đã chuyển cấu hình cũ sang $PREFS_DIR/"
fi

# Nếu người dùng từng bị vòng lặp crash, kill switch có thể còn sót lại và sẽ chặn
# bản vừa cài. Báo cho họ biết thay vì để tweak im lặng không hoạt động.
for KILLSWITCH in "$PREFS_DIR/com.opencarplay.disabled" \
                  "/var/jb$PREFS_DIR/com.opencarplay.disabled" \
                  "/var/mobile/Media/OpenCarPlay/DISABLED"; do
    if [ -f "$KILLSWITCH" ]; then
        echo "OpenCarPlay: kill switch đang bật, tweak sẽ KHÔNG nạp."
        echo "  Xoá để bật lại: rm $KILLSWITCH"
    fi
done

# Từ 0.38.0 dylib mới thực sự được nạp (trước đó nó nằm ở thư mục ElleKit không đọc).
# Nghĩa là file STAGE sót lại từ các lần chẩn đoán trước, vốn vô hại, nay có hiệu lực
# thật và sẽ chạy mã chưa kiểm chứng ngay lần khởi động đầu tiên. Vô hiệu hoá nó — đổi
# tên chứ không xoá, để khôi phục được.
STAGE_FILE="/var/mobile/Media/OpenCarPlay/STAGE"
if [ -f "$STAGE_FILE" ] && [ "$(cat "$STAGE_FILE" 2>/dev/null | tr -dc 0-9)" != "0" ]; then
    mv "$STAGE_FILE" "$STAGE_FILE.disabled-by-install"
    echo "OpenCarPlay: đã vô hiệu hoá file STAGE cũ (giá trị > 0)."
    echo "  Từ bản này dylib mới thực sự được nạp, nên giá trị đó sẽ chạy mã chưa kiểm chứng."
    echo "  Khôi phục nếu bạn thật sự muốn: mv $STAGE_FILE.disabled-by-install $STAGE_FILE"
fi

# File STAGE qua cáp USB thắng mọi cấu hình trong Cài đặt. Nếu còn sót lại từ lần cứu
# hộ trước, người dùng sẽ đổi giai đoạn trong Cài đặt mà không thấy gì thay đổi.
if [ -f /var/mobile/Media/OpenCarPlay/STAGE ]; then
    echo "OpenCarPlay: còn file STAGE cứu hộ — nó GHI ĐÈ lựa chọn trong Cài đặt."
    echo "  Xoá để Cài đặt có tác dụng trở lại:"
    echo "    rm /var/mobile/Media/OpenCarPlay/STAGE"
fi

# Dấu "đang khởi tạo" còn sót nghĩa là lần khởi động trước đã treo. Cố ý KHÔNG xoá:
# nó là thứ giữ cho lần khởi động tới hạ về giai đoạn 0 và máy lên được.
if [ -f "$PREFS_DIR/com.opencarplay.bootstrapping" ]; then
    echo "OpenCarPlay: lần khởi động trước không hoàn tất khởi tạo."
    echo "  Lần tới tweak tự hạ về giai đoạn 0 (chỉ nạp) để máy lên được."
    echo "  Chọn lại giai đoạn trong Cài đặt → OpenCarPlay khi bạn muốn thử tiếp."
fi

# Sinh trang "Chọn ứng dụng". Bảng cài đặt không có mã thực thi nên danh sách phải
# được quét từ ngoài Settings — xem đầu file opencarplay-refresh-apps.
REFRESH="$JBROOT/usr/bin/opencarplay-refresh-apps"
[ -x "$REFRESH" ] || REFRESH="/usr/bin/opencarplay-refresh-apps"
if [ -x "$REFRESH" ]; then
    "$REFRESH" || echo "OpenCarPlay: không quét được danh sách ứng dụng, chạy tay: opencarplay-refresh-apps"
else
    echo "OpenCarPlay: không tìm thấy opencarplay-refresh-apps"
fi

echo "OpenCarPlay: đã cài."
echo "  Mặc định là GIAI ĐOẠN 0 — dylib được nạp nhưng không chạm gì vào hệ thống."
echo "  Respring, rồi mở Cài đặt → OpenCarPlay."
echo "  Sau khi cài thêm ứng dụng mới, chạy: opencarplay-refresh-apps"

# --- BÁO CÁO CÀI ĐẶT -----------------------------------------------------------
#
# Ghi ra vùng AFC để đọc được qua cáp USB mà không cần SSH hay Filza.
#
# Sinh ra vì một câu hỏi không trả lời nổi từ xa: dylib có THẬT SỰ nằm trong thư mục
# injector không. syslog chứng minh được nó không được nạp, nhưng không cho biết vì sao
# — file không có, hay có mà bị từ chối. postinst chạy quyền root và đọc được /var/jb,
# nên nó là chỗ duy nhất trả lời được câu đó.
REPORT_DIR=/var/mobile/Media/OpenCarPlay
REPORT="$REPORT_DIR/install-report.txt"
mkdir -p "$REPORT_DIR" 2>/dev/null || true

{
    echo "OpenCarPlay - bao cao cai dat"
    echo "thoi diem : $(date 2>/dev/null)"
    echo "jbroot    : ${JBROOT:-(khong phat hien duoc)}"
    echo

    echo "--- thu muc injector ---"
    for d in "$JBROOT/usr/lib/TweakInject" "$JBROOT/Library/MobileSubstrate/DynamicLibraries"; do
        if [ -e "$d" ]; then
            echo "[co] $d"
            [ -L "$d" ] && echo "     LA SYMLINK -> $(readlink "$d" 2>/dev/null)"
            ls -la "$d" 2>/dev/null | sed 's/^/     /'
        else
            echo "[khong co] $d"
        fi
    done
    echo

    echo "--- file cua OpenCarPlay ---"
    for f in "$JBROOT/usr/lib/TweakInject/OpenCarPlay.dylib" \
             "$JBROOT/usr/lib/TweakInject/OpenCarPlay.plist" \
             "$JBROOT/Library/MobileSubstrate/DynamicLibraries/OpenCarPlay.dylib"; do
        if [ -e "$f" ]; then
            echo "[co] $f  ($(wc -c < "$f" 2>/dev/null) byte)"
        else
            echo "[KHONG CO] $f"
        fi
    done
    echo

    echo "--- dpkg ghi nhan goi cai nhung gi ---"
    dpkg -L com.opencarplay.tweak 2>&1 | sed 's/^/     /' || echo "     (dpkg khong tra loi)"
    echo

    echo "--- tweak khac dang co (doi chieu) ---"
    ls "$JBROOT/usr/lib/TweakInject"/*.dylib 2>/dev/null | sed 's/^/     /' \
        || echo "     (khong liet ke duoc)"
} > "$REPORT" 2>&1
chmod 644 "$REPORT" 2>/dev/null || true
chown mobile "$REPORT" 2>/dev/null || true

echo "OpenCarPlay: da ghi bao cao cai dat vao $REPORT"
echo "  Doc tu may tinh: afcclient get /OpenCarPlay/install-report.txt report.txt"

# Đăng ký trust cache nếu jailbreak có công cụ. Trên Dopamine, binary không nằm trong
# trust cache sẽ bị từ chối nạp và ElleKit bỏ qua trong im lặng.
for TC in "$JBROOT/basebin/jbctl" "$JBROOT/usr/bin/jbctl"; do
    if [ -x "$TC" ]; then
        "$TC" trustcache add "$JBROOT/usr/lib/TweakInject/OpenCarPlay.dylib" >/dev/null 2>&1 \
            && echo "OpenCarPlay: da them dylib vao trust cache" || true
        break
    fi
done

# Đối chiếu với PreferenceLoader — phụ thuộc bắt buộc, nên vị trí dylib của nó chính là
# thư mục mà ElleKit trên máy này đọc.
REF=""
for f in "$JBROOT/usr/lib/TweakInject/PreferenceLoader.dylib" \
         "$JBROOT/Library/MobileSubstrate/DynamicLibraries/PreferenceLoader.dylib"; do
    [ -f "$f" ] && REF="$f" && break
done
if [ -n "$REF" ]; then
    INJECT_DIR=$(dirname "$REF")
    if [ ! -f "$INJECT_DIR/OpenCarPlay.dylib" ]; then
        echo "OpenCarPlay: CANH BAO - dylib khong nam cung cho voi PreferenceLoader."
        echo "  ElleKit doc: $INJECT_DIR"
        echo "  Tweak se KHONG duoc nap."
    fi
fi

exit 0
