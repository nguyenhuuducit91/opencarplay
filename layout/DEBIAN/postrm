#!/bin/sh
# OpenCarPlay — sau khi gỡ.
#
# Gỡ thường giữ lại cấu hình (người dùng hay cài lại). Chỉ khi purge mới xoá sạch
# mọi thứ tweak từng tạo ra.

set -e

PREFS_DIR="/var/mobile/Library/Preferences"
LEGACY_PREFS_DIR="/var/jb/var/mobile/Library/Preferences"

killall -9 CarPlay 2>/dev/null || true

case "$1" in
    purge)
        for DIR in "$PREFS_DIR" "$LEGACY_PREFS_DIR"; do
            rm -f "$DIR"/com.opencarplay.plist
            rm -f "$DIR"/com.opencarplay.disabled
            rm -f "$DIR"/com.opencarplay.loads.plist
            rm -f "$DIR"/com.opencarplay.running-*
            rm -f "$DIR"/com.opencarplay.*.payload.plist
        done
        # cfprefsd giữ bản nhớ đệm của domain; xoá file không thôi thì lần ghi sau
        # nó dựng lại từ bộ nhớ.
        killall -9 cfprefsd 2>/dev/null || true
        rm -rf /var/mobile/Media/OpenCarPlay
        rm -rf /var/mobile/Library/Logs/OpenCarPlay
        echo "OpenCarPlay: đã xoá cấu hình và dữ liệu khảo sát."
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        echo "OpenCarPlay: đã gỡ. Cấu hình vẫn được giữ lại;"
        echo "  dùng 'dpkg --purge com.opencarplay.tweak' để xoá sạch."
        ;;
esac

echo "OpenCarPlay: respring để gỡ hẳn khỏi SpringBoard."
exit 0
