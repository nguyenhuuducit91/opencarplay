<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  OpenCarPlay — file cấu hình mẫu.

  Cách bình thường là dùng Cài đặt → OpenCarPlay. File này chỉ dành cho lúc chưa vào
  được giao diện máy, hoặc để thấy toàn bộ khoá ở một chỗ.

  Chép tới:  /var/mobile/Library/Preferences/com.opencarplay.plist
  rồi:       killall -9 cfprefsd && killall -9 SpringBoard

  killall cfprefsd là bắt buộc: cfprefsd giữ bản nhớ đệm của domain này và sẽ đè lên
  file nếu bạn sửa file mà không báo cho nó.

  Mọi khoá đều tuỳ chọn; thiếu khoá nào thì dùng mặc định (tắt, trừ ForceLandscape).
-->
<plist version="1.0">
<dict>
	<!-- Công tắc chính. NO nghĩa là tweak không thay đổi gì trong hệ thống. -->
	<key>Enabled</key>
	<false/>

	<!-- Ứng dụng được phép dùng với CarPlay. Thay bằng bundle id trên máy bạn.
	     Process hệ thống (springboard, CarPlayApp...) luôn bị chặn dù có liệt kê ở đây. -->
	<key>AllowedApplications</key>
	<array>
		<string>com.google.Maps</string>
		<string>com.vietmap.VietMapLive</string>
	</array>

	<key>AutoLaunch</key>
	<false/>
	<key>HideStatusBar</key>
	<false/>
	<key>FullScreen</key>
	<false/>
	<key>ForceLandscape</key>
	<true/>

	<!-- Ghi log đầy đủ. Mặc định chỉ ghi lỗi. -->
	<key>DebugLogging</key>
	<true/>

	<!-- Công cụ nghiên cứu — xem README. BẬT TỪNG CÁI MỘT, không bật cùng lúc.
	     RuntimeSurvey ghi khảo sát runtime vào /var/mobile/Media/OpenCarPlay/
	     SignalDiscovery ghi lại tên notification liên quan CarPlay mà SpringBoard nhận -->
	<key>RuntimeSurvey</key>
	<false/>
	<key>SignalDiscovery</key>
	<false/>

	<!-- THỬ NGHIỆM: đưa ứng dụng trong AllowedApplications lên dashboard CarPlay.
	     Tách riêng khỏi Enabled vì đây là phần đầu tiên thực sự thay đổi hành vi
	     CarPlay và chưa được kiểm chứng trên thiết bị thật. Nếu dashboard có vấn đề,
	     đặt lại false rồi killall -9 CarPlay là mọi thứ trở lại nguyên bản. -->
	<key>ExperimentalDiscovery</key>
	<false/>

	<!-- THỬ NGHIỆM, RỦI RO CAO NHẤT: gắn giao diện ứng dụng lên màn hình xe.
	     Phần này chạm vào bộ máy scene của SpringBoard. Nếu chuỗi private API đã đổi
	     trên iOS 18.6, tweak sẽ từ chối chạy và ghi log thay vì crash — nhưng hãy
	     chuẩn bị sẵn đường vào máy (SSH hoặc Filza) trước khi bật.
	     Có lưới tự tắt: nếu SpringBoard nạp lại 4 lần trong 45 giây, tweak tự tạo
	     /var/mobile/Library/Preferences/com.opencarplay.disabled và ngừng hoạt động. -->
	<key>ExperimentalSceneHosting</key>
	<false/>
</dict>
</plist>
